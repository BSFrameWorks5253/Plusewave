<?xml version="1.0" encoding="utf-8"?>
<!-- Pulse Wave - Neomorphic glowing play/pause button with ambient neon halo and frosted core -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer ambient neon bloom -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#807928CA"
                android:endColor="#8000DFD8"
                android:type="linear" />
        </shape>
    </item>
    <!-- Inner frosted glass button body -->
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#59FFFFFF"
                android:endColor="#26FFFFFF"
                android:type="linear" />
            <stroke
                android:width="1.2dp"
                android:color="#99FFFFFF" />
        </shape>
    </item>
</layer-list>
