<?xml version="1.0" encoding="utf-8"?>
<!-- Compact 4x1 Widget - Single row with album art, song info, full playback and like controls -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/Theme.Widget.PulseWave">

    <ImageView
        android:id="@+id/widget_wide_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card_preview"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical">

        <!-- Album Art - Square -->
        <ImageView
            android:id="@+id/widget_wide_album_art"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/album_art" />

        <!-- Song Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_wide_song_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/not_playing"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/widget_on_card"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_wide_artist_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tap_to_play"
                android:textSize="12sp"
                android:alpha="0.75"
                android:textColor="@color/widget_on_card"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Previous Button -->
        <ImageView
            android:id="@+id/widget_wide_prev_button"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:padding="3dp"
            android:layout_marginEnd="4dp"
            android:alpha="0.85"
            android:src="@drawable/ic_widget_skip_previous"
            android:contentDescription="@string/previous" />

        <!-- Play/Pause Button -->
        <ImageView
            android:id="@+id/widget_wide_play_pause"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="2dp"
            android:src="@drawable/ic_widget_play"
            android:contentDescription="@string/play_pause" />

        <!-- Next Button -->
        <ImageView
            android:id="@+id/widget_wide_next_button"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:padding="3dp"
            android:layout_marginStart="4dp"
            android:alpha="0.85"
            android:src="@drawable/ic_widget_skip_next"
            android:contentDescription="@string/next" />

        <!-- Like Button -->
        <ImageView
            android:id="@+id/widget_wide_like_button"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="10dp"
            android:alpha="0.9"
            android:src="@drawable/ic_widget_heart_outline_nav"
            android:contentDescription="@string/like" />

        <!-- Quick Play Playlist Button -->
        <ImageView
            android:id="@+id/widget_wide_playlist_button"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="8dp"
            android:alpha="0.9"
            android:src="@drawable/playlist_play"
            android:contentDescription="@string/filter_playlists" />
    </LinearLayout>
</FrameLayout>
