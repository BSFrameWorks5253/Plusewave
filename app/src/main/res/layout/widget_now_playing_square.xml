<?xml version="1.0" encoding="utf-8"?>
<!-- Apple Music style "Now Playing" widget, square (2x2). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/Theme.Widget.PulseWave">

    <ImageView
        android:id="@+id/widget_np_sq_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card_preview"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <ImageView
            android:id="@+id/widget_np_sq_album_art"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/album_art" />

        <TextView
            android:id="@+id/widget_np_sq_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/not_playing"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/widget_on_card"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_np_sq_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tap_to_play"
            android:textSize="13sp"
            android:alpha="0.75"
            android:textColor="@color/widget_on_card"
            android:maxLines="1"
            android:ellipsize="end" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Controls row: Prev, Play/Pause Pill, Next, Like -->
        <LinearLayout
            android:id="@+id/widget_np_sq_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/widget_np_sq_prev"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:padding="3dp"
                android:layout_marginEnd="6dp"
                android:alpha="0.85"
                android:src="@drawable/ic_widget_skip_previous"
                android:contentDescription="@string/previous" />

            <LinearLayout
                android:id="@+id/widget_np_sq_pill"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:background="@drawable/widget_pill_scrim_light">

                <ImageView
                    android:id="@+id/widget_np_sq_play_pause"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_widget_play"
                    android:contentDescription="@string/play_pause" />

                <TextView
                    android:id="@+id/widget_np_sq_pill_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:text="@string/widget_play"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_on_card" />
            </LinearLayout>

            <ImageView
                android:id="@+id/widget_np_sq_next"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:padding="3dp"
                android:layout_marginStart="6dp"
                android:alpha="0.85"
                android:src="@drawable/ic_widget_skip_next"
                android:contentDescription="@string/next" />

            <ImageView
                android:id="@+id/widget_np_sq_like"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:padding="2dp"
                android:layout_marginStart="8dp"
                android:alpha="0.9"
                android:src="@drawable/ic_widget_heart_outline_nav"
                android:contentDescription="@string/like" />
        </LinearLayout>

        <!-- Progress bar -->
        <FrameLayout
            android:id="@+id/widget_np_sq_progress"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="8dp">

            <ImageView
                android:id="@+id/widget_np_sq_progress_track"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.3"
                android:src="@drawable/widget_progress_track"
                android:scaleType="fitXY"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/widget_np_sq_progress_fill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_progress_clip"
                android:scaleType="fitXY"
                android:contentDescription="@null" />
        </FrameLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_np_sq_glyph"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|end"
        android:layout_margin="14dp"
        android:alpha="0.9"
        android:src="@drawable/ic_launcher_mono"
        android:contentDescription="@null" />
</FrameLayout>
