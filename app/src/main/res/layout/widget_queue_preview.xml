<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/Theme.Widget.PulseWave">

    <ImageView
        android:id="@+id/widget_queue_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card_preview"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Now Playing Header -->
        <LinearLayout
            android:id="@+id/widget_queue_now_playing_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/widget_queue_art"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:scaleType="centerCrop"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="@string/album_art" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_queue_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/not_playing"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_on_card"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_queue_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@string/tap_to_play"
                    android:textSize="12sp"
                    android:alpha="0.75"
                    android:textColor="@color/widget_on_card"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <ImageView
                android:id="@+id/widget_queue_prev"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="4dp"
                android:alpha="0.85"
                android:src="@drawable/ic_widget_skip_previous"
                android:contentDescription="@string/previous" />

            <ImageView
                android:id="@+id/widget_queue_play_pause"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="4dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_widget_play"
                android:contentDescription="@string/play_pause" />

            <ImageView
                android:id="@+id/widget_queue_next"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="4dp"
                android:layout_marginStart="4dp"
                android:alpha="0.85"
                android:src="@drawable/ic_widget_skip_next"
                android:contentDescription="@string/next" />

            <!-- Quick Play Playlist Button -->
            <ImageView
                android:id="@+id/widget_queue_playlist"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="4dp"
                android:layout_marginStart="4dp"
                android:alpha="0.85"
                android:src="@drawable/playlist_play"
                android:contentDescription="@string/filter_playlists" />
        </LinearLayout>

        <!-- Divider line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:alpha="0.15"
            android:background="@android:color/white" />

        <!-- Up Next Section -->
        <TextView
            android:id="@+id/widget_queue_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_queue_up_next"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:alpha="0.65"
            android:textColor="@color/widget_on_card"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/widget_queue_empty_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_queue_empty"
            android:textSize="13sp"
            android:alpha="0.6"
            android:textColor="@color/widget_on_card"
            android:paddingVertical="8dp"
            android:visibility="gone" />

        <!-- Queue item 1 -->
        <LinearLayout
            android:id="@+id/widget_q_item_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="4dp">

            <TextView
                android:layout_width="16dp"
                android:layout_height="wrap_content"
                android:text="1."
                android:textSize="12sp"
                android:alpha="0.5"
                android:textColor="@color/widget_on_card" />

            <TextView
                android:id="@+id/widget_q_title_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/widget_on_card"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_q_artist_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="11sp"
                android:alpha="0.65"
                android:textColor="@color/widget_on_card"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Queue item 2 -->
        <LinearLayout
            android:id="@+id/widget_q_item_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="4dp">

            <TextView
                android:layout_width="16dp"
                android:layout_height="wrap_content"
                android:text="2."
                android:textSize="12sp"
                android:alpha="0.5"
                android:textColor="@color/widget_on_card" />

            <TextView
                android:id="@+id/widget_q_title_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/widget_on_card"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_q_artist_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="11sp"
                android:alpha="0.65"
                android:textColor="@color/widget_on_card"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Queue item 3 -->
        <LinearLayout
            android:id="@+id/widget_q_item_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="4dp">

            <TextView
                android:layout_width="16dp"
                android:layout_height="wrap_content"
                android:text="3."
                android:textSize="12sp"
                android:alpha="0.5"
                android:textColor="@color/widget_on_card" />

            <TextView
                android:id="@+id/widget_q_title_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/widget_on_card"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_q_artist_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="11sp"
                android:alpha="0.65"
                android:textColor="@color/widget_on_card"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
