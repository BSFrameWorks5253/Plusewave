<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_nothing_bg"
    android:padding="10dp"
    android:theme="@style/Theme.Widget.PulseWave">

    <!-- Top: Nothing OS Dot-Matrix LED Banner (e.g. PULSEWAVE > NOW PLAYING) -->
    <ImageView
        android:id="@+id/widget_nothing_banner"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginBottom="6dp"
        android:scaleType="fitCenter"
        android:contentDescription="PulseWave Dot Matrix Banner" />

    <!-- Bottom content row: Left = Recessed 3D Platter Chamber, Right = Frosted Accent Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Left Platter Chamber: Vinyl Record with spheres & direct touch controls -->
        <FrameLayout
            android:id="@+id/widget_nothing_turntable_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="36"
            android:layout_marginEnd="6dp">

            <ImageView
                android:id="@+id/widget_nothing_platter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="Vinyl Platter" />

            <!-- Touch targets: Left = Previous, Center = Play/Pause, Right = Next -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:weightSum="100">

                <ImageView
                    android:id="@+id/widget_nothing_touch_prev"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="30"
                    android:src="@android:color/transparent"
                    android:contentDescription="@string/previous" />

                <ImageView
                    android:id="@+id/widget_nothing_touch_play_pause"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="40"
                    android:src="@android:color/transparent"
                    android:contentDescription="@string/play_pause" />

                <ImageView
                    android:id="@+id/widget_nothing_touch_next"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="30"
                    android:src="@android:color/transparent"
                    android:contentDescription="@string/next" />
            </LinearLayout>
        </FrameLayout>

        <!-- Right: Rounded Accent Card with Album Art, Title, Artist, Progress, and Full Playback Controls -->
        <LinearLayout
            android:id="@+id/widget_nothing_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="64"
            android:background="@drawable/widget_nothing_card_bg"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <!-- 1. Track Info Row: Album Art + Title + Artist -->
            <LinearLayout
                android:id="@+id/widget_nothing_track_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/widget_nothing_art"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/widget_nothing_art_clip"
                    android:contentDescription="@string/album_art" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_nothing_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Track Title"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#18181B"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/widget_nothing_artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Artist Name"
                        android:textSize="10sp"
                        android:textColor="#52525B"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/widget_nothing_badge"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/pulsewave_notification"
                    android:contentDescription="PulseWave" />
            </LinearLayout>

            <!-- 2. Progress Bar & Time Labels -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="4dp"
                android:orientation="vertical">

                <ProgressBar
                    android:id="@+id/widget_nothing_progress"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:progressDrawable="@drawable/widget_nothing_progressbar"
                    android:max="1000"
                    android:progress="350" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_nothing_time_current"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#18181B" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/widget_nothing_time_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:textSize="10sp"
                        android:textColor="#52525B" />
                </LinearLayout>
            </LinearLayout>

            <!-- 3. Full Playback Controls Row: Prev, Rewind 10s, Play/Pause, Forward 10s, Next, Like -->
            <LinearLayout
                android:id="@+id/widget_nothing_controls_row"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:weightSum="6">

                <!-- Previous Track -->
                <ImageView
                    android:id="@+id/widget_nothing_btn_prev"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:padding="5dp"
                    android:src="@drawable/ic_widget_skip_previous"
                    android:tint="#18181B"
                    android:background="@drawable/widget_nothing_btn_ripple"
                    android:contentDescription="@string/previous" />

                <!-- Rewind 10 seconds -->
                <ImageView
                    android:id="@+id/widget_nothing_btn_rewind"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:padding="5dp"
                    android:src="@drawable/replay"
                    android:tint="#18181B"
                    android:background="@drawable/widget_nothing_btn_ripple"
                    android:contentDescription="Rewind 10s" />

                <!-- Play / Pause Button with dark circular badge -->
                <FrameLayout
                    android:id="@+id/widget_nothing_btn_play_container"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/widget_nothing_play_btn_bg">

                    <ImageView
                        android:id="@+id/widget_nothing_btn_play_pause"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_widget_play"
                        android:tint="#FFFFFF"
                        android:contentDescription="@string/play_pause" />
                </FrameLayout>

                <!-- Forward 10 seconds -->
                <ImageView
                    android:id="@+id/widget_nothing_btn_forward"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:padding="5dp"
                    android:src="@drawable/fast_forward"
                    android:tint="#18181B"
                    android:background="@drawable/widget_nothing_btn_ripple"
                    android:contentDescription="Forward 10s" />

                <!-- Next Track -->
                <ImageView
                    android:id="@+id/widget_nothing_btn_next"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:padding="5dp"
                    android:src="@drawable/ic_widget_skip_next"
                    android:tint="#18181B"
                    android:background="@drawable/widget_nothing_btn_ripple"
                    android:contentDescription="@string/next" />

                <!-- Favorite / Like Button -->
                <ImageView
                    android:id="@+id/widget_nothing_btn_like"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:padding="5dp"
                    android:src="@drawable/ic_widget_heart_outline_nav"
                    android:tint="#18181B"
                    android:background="@drawable/widget_nothing_btn_ripple"
                    android:contentDescription="@string/like" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
