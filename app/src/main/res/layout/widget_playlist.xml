<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/Theme.Widget.PulseWave">

    <ImageView
        android:id="@+id/widget_playlist_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card_preview"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/widget_playlist_art"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:scaleType="centerCrop"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="@string/filter_playlists" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_playlist_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_playlists"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:alpha="0.7"
                    android:textColor="@color/widget_on_card" />

                <TextView
                    android:id="@+id/widget_playlist_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/liked_songs"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_on_card"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_playlist_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tap to play"
                    android:textSize="12sp"
                    android:alpha="0.75"
                    android:textColor="@color/widget_on_card"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- Quick Play Button Pill -->
        <LinearLayout
            android:id="@+id/widget_playlist_play_container"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/widget_pill_scrim_light">

            <ImageView
                android:id="@+id/widget_playlist_play_icon"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_widget_play"
                android:contentDescription="@string/widget_play" />

            <TextView
                android:id="@+id/widget_playlist_play_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/widget_play"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/widget_on_card" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
